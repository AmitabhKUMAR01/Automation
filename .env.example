APP_NAME=scraped_raw_data

## Database Configuration
DATABASE_URL=mysql+pymysql://your_user:your_password@localhost:3306/scraped_raw_data
DB_HOST=localhost
DB_PORT=3306
DB_NAME=scraped_raw_data
DB_USER=root
DB_PASSWORD=

## Mail Configuration
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_HOST_USER=your_smtp_user
EMAIL_HOST_PASSWORD=your_smtp_password
EMAIL_PORT=2525
EMAIL_FROM=from@example.com

## Google Sheets Configuration
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_spreadsheet_id
GOOGLE_PRIVATE_KEY_ID=your_private_key_id
GOOGLE_SHEET_NAME="Client Data"

## Export Time to Sheet
EXPORT_SCHEDULE_HOUR=19
EXPORT_SCHEDULE_MINUTE=10

## LLM API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

## LLM Provider Configuration
LLM_PROVIDER=groq
LLM_API_DELAY_SEC=1.0
BATCH_SCORING_DELAY_SEC=4.0
PITCH_LLM_MIN_GRADE=C

## LinkedIn Authentication (Required for scraping/DM actions)
LINKDIN_EMAIL=your_linkedin_email@example.com
LINKIDINPASS=your_linkedin_password

## Background Scheduler Configuration (Optimal Pipeline Order)

# 1. Website Audit (scans website issues)
AUDIT_SCHEDULE_HOUR=15
AUDIT_SCHEDULE_MINUTE=0

# 2. LinkedIn Search (finds profile links for clients)
LINKEDIN_SCHEDULE_HOUR=13
LINKEDIN_SCHEDULE_MINUTE=0

# Set to true to run browser in headless mode (false = visible window)
LINKEDIN_HEADLESS=false
STORAGE_STATE_PATH=storage_state.json
LINKEDIN_BETWEEN_COMPANIES_DELAY=60
LINKEDIN_CONNECTIONS_DAILY_LIMIT=5

# 3. Lead Scoring & Pitch Generation (needs audit + profile existence)
LEAD_SCORE_SCHEDULE_HOUR=16
LEAD_SCORE_SCHEDULE_MINUTE=0

# 4. LinkedIn Connections (sends connection requests)
LINKEDIN_CONNECTIONS_SCHEDULE_HOUR=17
LINKEDIN_CONNECTIONS_SCHEDULE_MINUTE=0

# 5. LinkedIn Acceptance Check (checks pending requests)
LINKEDIN_ACCEPTANCE_SCHEDULE_HOUR=14
LINKEDIN_ACCEPTANCE_SCHEDULE_MINUTE=0

# 6. Pitch Delivery Job (Sends pending emails & DMs)
PITCH_DELIVERY_SCHEDULE_HOUR=18
PITCH_DELIVERY_SCHEDULE_MINUTE=0

## Pitch Delivery Tunings
LINKEDIN_DM_DAILY_LIMIT=5
LINKEDIN_DM_DELAY_SEC=8.0
EMAIL_DELIVERY_DELAY_SEC=2.0
MAX_DELIVERY_ATTEMPTS=3

## ── Notification System ─────────────────────────────────────────────────────
# Channel to use for alerts: "email" (default) | "slack" (future)
NOTIFICATION_CHANNEL=email

# Email channel — recipient for all alert emails
ALERT_EMAIL=your_alert_email@example.com

# Slack channel — activate by setting NOTIFICATION_CHANNEL=slack
# Create an Incoming Webhook at https://api.slack.com/apps and paste URL below
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

## ── Scheduler Retry Delays ──────────────────────────────────────────────────
# Delay (in seconds) before retrying a failed LinkedIn job (default: 30 min)
LINKEDIN_JOB_RETRY_DELAY_SEC=1800
# Delay (in seconds) before retrying any other failed job (default: 10 min)
DEFAULT_JOB_RETRY_DELAY_SEC=600
