# --- LLM (pick one provider; used by parse / match / compose) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://co.agentrouter.org
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Ingest: Apify LinkedIn Post Scraper ---
# Either name works (APIFY_API_TOKEN preferred)
APIFY_API_TOKEN=
# APIFY_API_KEY=
APIFY_ACTOR_ID=apimaestro/linkedin-posts-search-scraper-no-cookies

# --- Enrich (optional; stage skippable via config.yaml) ---
HUNTER_API_KEY=
APOLLO_API_KEY=

# --- Gmail OAuth (send stage) ---
GMAIL_CLIENT_SECRETS_PATH=credentials/gmail_client_secrets.json
GMAIL_TOKEN_PATH=credentials/gmail_token.json
GMAIL_SENDER=

# --- Paths ---
DATABASE_URL=sqlite:///./data/outreach.db
CONFIG_PATH=config.yaml

# LLM fallback order (comma list). Empty = single LLM_PROVIDER
LLM_PROVIDERS=openai,gemini,groq
# Free Gemini key: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Gemini models tried in order when one is overloaded/retired (each has its own free quota)
# GEMINI_MODELS=gemini-flash-latest,gemini-3.5-flash,gemini-flash-lite-latest

