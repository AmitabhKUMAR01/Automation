[Unit]
Description=LeadGen FastAPI Application
After=network.target

[Service]
# Change 'ubuntu' to your actual VPS username (e.g., root, ubuntu, debian)
User=ubuntu
Group=www-data

# Update this path to where you cloned the repository on your VPS
WorkingDirectory=/var/www/web-scrapping

# Point to your virtual environment's bin folder
Environment="PATH=/var/www/web-scrapping/venv/bin"
EnvironmentFile=/var/www/web-scrapping/.env

# Crucial: Must use exactly 1 worker so APScheduler doesn't duplicate jobs
ExecStart=/var/www/web-scrapping/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
