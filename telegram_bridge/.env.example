
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=scraped_raw_data

# ── Auth Token ────────────────────────────────────────────────────────────────
# Used to protect the fetch/status-update endpoints.
# Must match WEBHOOK_TOKEN in your main project's .env so the local poller
# can authenticate when calling GET /pending-actions and PATCH .../status.
WEBHOOK_TOKEN=your_secret_token_here
