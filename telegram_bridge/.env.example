# ── Cloud Database ────────────────────────────────────────────────────────────
# Point to your cloud MySQL instance (Railway / PlanetScale / Supabase)
DB_HOST=your-cloud-db-host.railway.app
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=scraped_raw_data

# ── Auth Token ────────────────────────────────────────────────────────────────
# Must match WEBHOOK_TOKEN in your main project's .env
WEBHOOK_TOKEN=your_webhook_token_here
